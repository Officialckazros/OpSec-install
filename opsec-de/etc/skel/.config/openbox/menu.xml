<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="opsecDE">
    <item label="🔒 Control Center">
      <action name="Execute"><command>opsec-launch control-center</command></action>
    </item>
    <item label="🌐 Mullvad Browser">
      <action name="Execute"><command>opsec-launch mullvad-browser</command></action>
    </item>
    <item label="✉️ Proton Mail">
      <action name="Execute"><command>opsec-launch proton-mail</command></action>
    </item>
    <separator/>
    <menu id="apps" label="Applications">
      <item label="Terminal">
        <action name="Execute"><command>opsec-launch terminal</command></action>
      </item>
      <item label="File Manager">
        <action name="Execute"><command>pcmanfm</command></action>
      </item>
      <item label="App Launcher (rofi)">
        <action name="Execute"><command>rofi -show drun</command></action>
      </item>
      <item label="Network (nmtui)">
        <action name="Execute"><command>opsec-launch terminal -e nmtui</command></action>
      </item>
      <item label="PulseAudio Control">
        <action name="Execute"><command>pavucontrol</command></action>
      </item>
      <item label="System Monitor">
        <action name="Execute"><command>xfce4-taskmanager</command></action>
      </item>
    </menu>
    <menu id="security" label="Security">
      <item label="Status Scan (terminal)">
        <action name="Execute"><command>opsec-launch terminal -e /usr/bin/opsec</command></action>
      </item>
      <item label="Enforce Firewall">
        <action name="Execute"><command>pkexec /usr/local/sbin/opsec-firewall.sh</command></action>
      </item>
      <item label="Randomize MAC">
        <action name="Execute"><command>pkexec /usr/local/sbin/mac-spoof.sh</command></action>
      </item>
      <item label="Lock Screen">
        <action name="Execute"><command>i3lock -c 0f172a</command></action>
      </item>
    </menu>
    <menu id="install" label="Install">
      <item label="Install opsecOS to disk (full GUI installer)">
        <action name="Execute"><command>debian-installer-launcher</command></action>
      </item>
    </menu>
    <separator/>
    <item label="Refresh Software Suite">
      <action name="Execute"><command>opsec-launch terminal -e sudo /usr/bin/opsec-software-install</command></action>
    </item>
    <item label="Reconfigure Openbox">
      <action name="Reconfigure"/>
    </item>
    <separator/>
    <item label="Log Out">
      <action name="Exit"/>
    </item>
  </menu>
</openbox_menu>
